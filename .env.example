# Telegram-бот формы обратной связи
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── «Войти через Звоночек» (OIDC) ────────────────────────────────────
# client_id выдаёт BotCreator: бот → «Приложения» → создать OAuth-приложение
# с client_type=public и redirect_uri = http://127.0.0.1:3000/api/auth/zvonok/callback
# (сравнение побайтовое, и localhost вместо 127.0.0.1 не подойдёт).
ZVONOK_CLIENT_ID=
# Только для confidential-клиента (нужен https-redirect). Для public оставить пустым:
# присланный public-клиентом секрет провайдер считает ошибкой настройки.
ZVONOK_CLIENT_SECRET=
# Адрес провайдера. По умолчанию прод.
ZVONOK_ISSUER=https://zvo.is
# Запрашиваемые scopes. Аватарка и ник приходят с profile.
ZVONOK_SCOPE=openid profile
# Переопределяет redirect_uri, если он не выводится из адреса запроса.
ZVONOK_REDIRECT_URI=
# Ключ подписи session-cookie. Без него сессии умирают на рестарте dev-сервера:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZVONOK_AUTH_SECRET=
